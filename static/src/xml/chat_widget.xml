<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="customer_chat.ChatWidget" owl="1">
        <div class="chat-widget">
            <div class="chat-header">
                <span>Customer Chat</span>
                <button class="close-chat" t-on-click="toggleChat">×</button>
            </div>
            <div class="chat-body">
                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                    <div>
                        <span><t t-esc="msg.message"/></span>
                    </div>
                </t>
            </div>
            <div class="chat-footer">
                <input type="text" t-model="state.newMessage"
                       placeholder="Type a message..."
                       t-on-keydown="sendMessage"/>
                <button class="send-btn" t-on-click="sendMessage">Send</button>
            </div>
        </div>
    </t>
</templates>
