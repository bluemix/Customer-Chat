<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="customer_chat.ChatWidget" owl="1">
        <div class="chat-widget">
            <div class="chat-header">
                <span>Customer Chat</span>
            </div>
            <ul class="chat-body" t-ref="chat-body">
                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                    <li t-att-class="'chat-message card ' + (msg.sender_id[0] === 4 ? 'sent' : 'received')">
                        <div class="card-body">
                            <p class="card-text"><t t-esc="msg.message"/></p>
                            <small class="timestamp"><t t-esc="msg.timestamp"/></small>
                        </div>
                    </li>
                </t>
            </ul>
            <div class="chat-footer">
                <input type="text" t-model="state.newMessage"
                       placeholder="Type a message..."
                       t-on-keydown="sendMessage"/>
                <button class="send-btn" t-on-click="sendMessage">Send</button>
            </div>
        </div>
    </t>
</templates>
