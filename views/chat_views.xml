<odoo>
    <template id="chat_page_template">
        <t t-call="website.layout">
            <div class="container">
                <t t-set="session_data" t-value="{
                    'session_id': session_id
                }"/>
                <h2>Live Chat</h2>
                <owl-component name="customer_chat.ChatWidget" t-att-props="json.dumps(session_data)"/>
            </div>
        </t>
    </template>
</odoo>
