<odoo>
    <record id="view_chat_session_form" model="ir.ui.view">
        <field name="name">Chat Session Form</field>
        <field name="model">customer.chat.session</field>
        <field name="arch" type="xml">
            <form string="Chat Session">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="customer_id"/>
                        <field name="agent_id"/>
                        <field name="state"/>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids">
                                <tree>
                                    <field name="sender_id"/>
                                    <field name="message"/>
                                    <field name="timestamp"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
